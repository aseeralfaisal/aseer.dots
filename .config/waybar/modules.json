{
  "hyprland/workspaces": {
    "format": "{id}",
    "format-icons": {
      "active": "󰮯",
      "default": "󰮮"
    },
    "on-click": "activate",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": []
    },
    "ignore-workspaces": ["^(?:[5-9]|[1-9][0-9]+)$"]
  },

  "custom/workspace-overflow": {
    "format": "…",
    "tooltip-format": "More workspaces",
    "on-click": "~/.config/waybar/workspace_fallback.sh"
  },

  "cpu": {
    "format": "󰍛 CPU {usage}%"
  },

  "disk": {
    "interval": 30,
    "format": "󰋊 Disk {percentage_used}%"
  },

  "memory": {
    "format": " RAM {}%"
  },

  "clock": {
    "format": "{:%H:%M · %a %d %b}",
    "format-alt": "{:%A, %B %d, %Y}",
    "on-click": "gnome-calendar",
    "timezone": "Etc/GMT-6",
    "tooltip-format": "{:%A, %B %d, %Y}"
  },

  "custom/weather": {
    "format": "{}",
    "exec": "~/.config/waybar/weather.sh",
    "interval": 300,
    "on-click": "gnome-weather",
    "tooltip-format": "Weather"
  },

  "network": {
    "format": "{ifname}",
    "format-wifi": " {essid}",
    "format-ethernet": "  {ifname}",
    "format-disconnected": "Disconnected ⚠",
    "tooltip-format": " {ifname} via {gwaddri}",
    "tooltip-format-wifi": "  {ifname} @ {essid}\nIP: {ipaddr}\nStrength: {signalStrength}%\nFreq: {frequency}MHz\nUp: {bandwidthUpBits} Down: {bandwidthDownBits}",
    "tooltip-format-ethernet": " {ifname}\nIP: {ipaddr}\n up: {bandwidthUpBits} down: {bandwidthDownBits}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50,
    "on-click": "ghostty -e iwctl"
  },

  "bluetooth": {
    "format": " On",
    "format-connected": " Active",
    "format-disabled": "",
    "format-off": "",
    "interval": 30,
    "on-click": "blueman-manager",
    "format-no-controller": ""
  },

  "pulseaudio": {
    "format": "{icon} Vol {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-bluetooth-muted": "{icon} {format_source}",
    "format-muted": "{icon} Muted",
    "format-source": "{volume}% 󰍬",
    "format-source-muted": "󰍭",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋋",
      "headset": "󰋋",
      "phone": "󰘛",
      "portable": "󰘛",
      "car": "",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "  {capacity}%",
    "format-plugged": "  {capacity}%",
    "format-alt": "{icon}  {time}",
    "format-icons": [" ", " ", " ", " ", " "]
  },

  "custom/download": {
    "format": "{}",
    "exec": "~/.config/waybar/netspeed.sh download",
    "tooltip-format": "Download speed"
  },

  "custom/upload": {
    "format": "{}",
    "exec": "~/.config/waybar/netspeed.sh upload",
    "tooltip-format": "Upload speed"
  },

  "custom/exit": {
    "format": "󰐦",
    "on-click": "~/.config/wofi/powermenu.sh",
    "tooltip-format": "Power Menu"
  },

  "group/workspace-strip": {
    "orientation": "horizontal",
    "modules": ["hyprland/workspaces", "custom/workspace-overflow"]
  },

  "group/resources": {
    "orientation": "horizontal",
    "modules": ["cpu", "disk", "memory"]
  },

  "group/date-weather": {
    "orientation": "horizontal",
    "modules": ["clock", "custom/weather"]
  },

  "group/status": {
    "orientation": "horizontal",
    "modules": ["network", "bluetooth", "pulseaudio", "battery"]
  },

  "group/transfers-power": {
    "orientation": "horizontal",
    "modules": ["custom/download", "custom/upload", "custom/exit"]
  }
}
