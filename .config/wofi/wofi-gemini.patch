+	gtk_flow_box_invalidate_sort(GTK_FLOW_BOX(inner_box));
+	GtkAdjustment* adjustment = gtk_scrolled_window_get_vadjustment(GTK_SCROLLED_WINDOW(scroll));
+	gtk_adjustment_set_value(adjustment, gtk_adjustment_get_lower(adjustment));
+}
+
+static void gemini_finished(GObject* source, GAsyncResult* result, gpointer data) {
+	gchar* question = data;
+	gchar* output = NULL;
+	gchar* errors = NULL;
+	GError* error = NULL;
+	gboolean communicated = g_subprocess_communicate_utf8_finish(
+			G_SUBPROCESS(source), result, &output, &errors, &error);
+
+	if(communicated && g_subprocess_get_successful(G_SUBPROCESS(source))
+			&& output != NULL && strlen(g_strstrip(output)) > 0) {
+		set_gemini_result(output);
+	} else if(errors != NULL && strlen(g_strstrip(errors)) > 0) {
+		set_gemini_result(errors);
+	} else if(error != NULL) {
+		set_gemini_result("Gemini could not be reached. Try again shortly.");
+	} else {
+		set_gemini_result("Gemini returned no answer.");
+	}
+
+	gtk_entry_set_icon_from_icon_name(GTK_ENTRY(entry), GTK_ENTRY_ICON_SECONDARY,
+			"chat-message-new-symbolic");
+	gtk_entry_set_icon_sensitive(GTK_ENTRY(entry), GTK_ENTRY_ICON_SECONDARY, TRUE);
+	g_clear_error(&error);
+	g_free(output);
+	g_free(errors);
+	g_free(question);
+}
+
+static void ask_gemini(GtkEntry* search_entry, GtkEntryIconPosition position,
+		GdkEvent* event, gpointer data) {
+	(void) event;
+	(void) data;
+	if(position != GTK_ENTRY_ICON_SECONDARY) {
+		return;
+	}
+	if(!gtk_entry_get_icon_sensitive(search_entry, GTK_ENTRY_ICON_SECONDARY)) {
+		return;
+	}
+
+	gchar* question = g_strdup(gtk_entry_get_text(search_entry));
+	g_strstrip(question);
+	if(strlen(question) == 0) {
+		gtk_widget_error_bell(GTK_WIDGET(search_entry));
+		g_free(question);
+		return;
+	}
+
+	gtk_entry_set_icon_sensitive(search_entry, GTK_ENTRY_ICON_SECONDARY, FALSE);
+	gtk_entry_set_icon_from_icon_name(search_entry, GTK_ENTRY_ICON_SECONDARY,
+			"content-loading-symbolic");
+	set_gemini_result("Asking Gemini…");
+
+	gchar* helper = g_build_filename(g_get_home_dir(), ".config", "wofi", "gemini.py", NULL);
+	GError* error = NULL;
+	GSubprocess* process = g_subprocess_new(
+			G_SUBPROCESS_FLAGS_STDIN_PIPE |
+			G_SUBPROCESS_FLAGS_STDOUT_PIPE |
+			G_SUBPROCESS_FLAGS_STDERR_PIPE,
+			&error, "/usr/bin/python3", helper, "--stdio", NULL);
+	g_free(helper);
+
+	if(process == NULL) {
+		set_gemini_result("Gemini could not be started.");
+		gtk_entry_set_icon_from_icon_name(search_entry, GTK_ENTRY_ICON_SECONDARY,
+				"chat-message-new-symbolic");
+		gtk_entry_set_icon_sensitive(search_entry, GTK_ENTRY_ICON_SECONDARY, TRUE);
+		g_clear_error(&error);
+		g_free(question);
+		return;
+	}
+
+	g_subprocess_communicate_utf8_async(process, question, NULL, gemini_finished, question);
+	g_object_unref(process);
+}
