+static GtkWidget* get_tile_label(GtkWidget* tile_content) {
+	if(!GTK_IS_CONTAINER(tile_content)) {
+		return NULL;
+	}
+	GList* children = gtk_container_get_children(GTK_CONTAINER(tile_content));
+	GtkWidget* label = NULL;
+	for(GList* node = children; node != NULL; node = node->next) {
+		if(GTK_IS_LABEL(node->data)) {
+			label = GTK_WIDGET(node->data);
+			break;
+		}
+	}
+	g_list_free(children);
+	return label;
+}
+
+static void style_tile_content(GtkWidget* tile_content, gboolean searching) {
+	GtkWidget* label = get_tile_label(tile_content);
+	searching = searching || columns == 1;
+	gtk_widget_set_halign(tile_content, searching ? GTK_ALIGN_START : content_halign);
+	if(label == NULL) {
+		return;
+	}
+	gtk_widget_set_hexpand(label, !searching);
+	gtk_label_set_xalign(GTK_LABEL(label), searching ? 0.0 : 0.5);
+	gtk_label_set_max_width_chars(GTK_LABEL(label), searching ? -1 : 14);
+	if(GTK_IS_BOX(tile_content)) {
+		gtk_box_set_child_packing(GTK_BOX(tile_content), label, !searching, !searching, 0, GTK_PACK_START);
+	}
+}
+
+static void style_columns(gboolean searching) {
+	GtkStyleContext* context = gtk_widget_get_style_context(inner_box);
+	if(!searching && columns == 3) {
+		gtk_style_context_add_class(context, "three-columns");
+	} else {
+		gtk_style_context_remove_class(context, "three-columns");
+	}
+}
